# Base URLs for the two public test APIs used by this suite.
OBJECTS_API_BASE_URL=https://api.restful-api.dev
AUTH_API_BASE_URL=https://dummyjson.com

# Known-good credentials for the dummyjson demo auth service (public test data, not a secret).
AUTH_USERNAME=emilys
AUTH_PASSWORD=emilyspass

# Request timeout in seconds applied by the API clients.
REQUEST_TIMEOUT=10

# Response-time threshold (seconds) used by the performance assertion test.
PERF_THRESHOLD_SECONDS=2.0
